rules_version = '2';

// Each player can read and write only their own save document: saves/{their auth uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['data', 'savedAt', 'updatedAt'])
                            && request.resource.data.savedAt is number
                            && request.resource.data.data is map;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
